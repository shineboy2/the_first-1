# =========================================================================
# فایل تنظیم IP - قبل از اجرای change_ip.sh این فایل را پر کنید
# =========================================================================
# نام فایل را به ip_config.env تغییر دهید:
#   cp ip_config.env.example ip_config.env
#   nano ip_config.env
# =========================================================================

# ---- برای سرور Response Network ----
# MY_IP: IP این سرور که کاربران از طریق آن به API و پنل دسترسی دارند
MY_IP=192.168.1.10

# ES_IP: IP سرور Elasticsearch
ES_IP=192.168.1.12

# FTP_IP: IP سرور FTP (معمولاً همان Elasticsearch)
FTP_IP=192.168.1.12

# ---- برای سرور Request Network ----
# MY_IP: IP این سرور
# MY_IP=192.168.1.11

# FTP_IP: IP سرور FTP (معمولاً سرور Response)
# FTP_IP=192.168.1.10