# Build stage
FROM python:3.11-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy unified requirements
COPY requirements.txt .

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r requirements.txt

# Final stage
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy ONLY request-network code (network separation)
COPY request-network/ /app/request-network/

# Set working directory to API
WORKDIR /app/request-network/api

# Create export/import directories
RUN mkdir -p exports/requests imports/requests imports/users imports/settings

# Set PYTHONPATH to include API directory
ENV PYTHONPATH="/app/request-network/api:${PYTHONPATH}"

# Make entrypoint executable if exists
RUN if [ -f "/app/request-network/entrypoint-request.sh" ]; then chmod +x /app/request-network/entrypoint-request.sh; fi

# Default command
CMD ["python", "main.py"]
